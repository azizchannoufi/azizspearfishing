rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isPublished() {
      return resource.data.published == true;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /athlete/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public portfolio collections: readable so the site can list without
    // waiting on composite indexes. Visibility is enforced in app code.
    match /athleteStats/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /achievements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /competitions/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Keep drafts private
    match /articles/{docId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /messages/{docId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'createdAt', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.status == 'unread'
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    match /socialLinks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analyticsDaily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analyticsPages/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analyticsGallery/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analyticsVideos/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /analyticsArticles/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activityLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
